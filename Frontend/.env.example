# Leave this empty in local development: Vite proxies /api to localhost:5000.
# For production, set the deployed backend API base URL.
VITE_API_URL=https://your-jobtrack-backend.onrender.com/api

# Optional TURN server for difficult networks (recommended for production WebRTC)
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=...
# VITE_TURN_CREDENTIAL=...
